NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081
# Neon > your project > Connect > pooled connection string (use ?sslmode=verify-full)
DATABASE_URL=
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Cloudinary console > Settings > API Keys (the secret stays on the server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Password-reset emails via Brevo (optional; reset is off without them).
# Brevo > SMTP & API > API Keys; MAIL_FROM_EMAIL must be a verified Brevo sender.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
# Optional: where suspended users are told to appeal.
SUPPORT_EMAIL=
